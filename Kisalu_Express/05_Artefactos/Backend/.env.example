# Servidor
PORT=3000
NODE_ENV=development

# CORS: origens autorizadas, separadas por vírgulas (ex.: https://app.kisalu.ao,http://localhost:5173).
# Vazio = aceita qualquer origem, só em desenvolvimento. Em produção é obrigatório.
CORS_ORIGINS=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kisalu_express

# Autenticação
JWT_SECRET=troca-isto-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_DAYS=30
CODIGO_EXPIRES_MIN=10

# Entrada por SMS (simulado: o código aparece no terminal da API)
SMS_EXPIRES_MIN=5
SMS_REENVIAR_S=60
# Máximo de códigos (SMS ou email) por número/email em 10 minutos
CODIGO_MAX_POR_10MIN=3

# Confirmação do serviço: validade do QR e janela para "Desfazer" a aceitação
QR_VALIDADE_MIN=10
DESFAZER_ACEITACAO_MIN=5
# Só fora de produção: código alternativo ao QR sempre igual, para demonstrações (vazio = aleatório)
CODIGO_QR_FIXO_DEV=482173

# Email (código de entrada). Sem SMTP_HOST, o código só aparece no terminal.
# No docker-compose o email vai para o Mailpit: http://localhost:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Kisalu Express <nao-responder@kisalu.ao>

# Uploads
UPLOAD_DIR=uploads
# Documentos de identidade e fotos de reclamações (não são servidos em /uploads; só o admin os vê pela API)
PRIVADO_DIR=privado
UPLOAD_MAX_MB=5
