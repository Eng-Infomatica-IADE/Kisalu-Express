# Servidor
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kisalu_express

# Autenticação
JWT_SECRET=
JWT_EXPIRES_DAYS=30
CODIGO_EXPIRES_MIN=10

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5
# Email (código de entrada). Sem SMTP_HOST, o código só aparece no terminal.
# No docker-compose o email vai para o Mailpit: http://localhost:8025
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Kisalu Express <nao-responder@kisalu.ao>
